{
  "name": "metsainfo",
  "version": "3.3.0",
  "description": "Suomen metsävaratiedot kartalla",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:kuvat": "VITE_KUVAUSTILA=1 vite build",
    "dev:kuvat": "VITE_KUVAUSTILA=1 vite",
    "build:kokeilu": "VITE_KOKEILU=1 vite build",
    "dev:kokeilu": "VITE_KOKEILU=1 vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ios:sync": "npm run build && node scripts/sync-version.mjs && cap sync ios",
    "ios:sync:kokeilu": "npm run build:kokeilu && METSAINFO_KOKEILU=1 node scripts/sync-version.mjs && cap sync ios",
    "ios:open": "cap open ios",
    "android:sync": "npm run build && node scripts/sync-version.mjs && cap sync android",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "jsdom": "^30.1.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "flatbush": "4.7.0",
    "leaflet": "1.9.4",
    "proj4": "2.9.0",
    "proj4leaflet": "1.0.2"
  }
}
