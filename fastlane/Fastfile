# Metsäinfo iOS -julkaisu.
#
# API-avain luetaan ympäristömuuttujista, ei koskaan reposta:
#   source ~/code/appstoreconnect.env
#   fastlane ios metadata      # kauppatekstit (fastlane/metadata/fi)
#   fastlane ios screenshots   # kuvakaappaukset (fastlane/screenshots/fi)
#   fastlane ios check         # tarkistaa yhteyden ja nykyiset tiedot
#   fastlane ios availability  # jakelu vain Suomeen
#   fastlane ios release_settings  # ikäluokitus, sisältöoikeudet, hinta, build

default_platform(:ios)

platform :ios do
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_ID"),
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: File.expand_path(ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"))
    )
  end

  desc "Tarkistaa API-yhteyden ja näyttää sovelluksen tiedot"
  lane :check do
    asc_key
    app = Spaceship::ConnectAPI::App.find("fi.inetor.metsainfo")
    UI.user_error!("Sovellusta ei löydy App Store Connectista") unless app
    UI.message("Sovellus: #{app.name} (#{app.bundle_id}), id #{app.id}, ensisijainen kieli #{app.primary_locale}")
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.message("Muokattava versio: #{version&.version_string || '-'} (#{version&.app_store_state || '-'})")
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 5)
    builds.each { |b| UI.message("Build #{b.version} (#{b.app_version}): #{b.processing_state}") }
  end

  desc "Päivittää kauppatekstit (fastlane/metadata)"
  lane :metadata do
    asc_key
    deliver(
      app_version: app_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      # Yhteystiedot ympäristöstä (~/code/appstoreconnect.env), eivät repossa
      app_review_information: {
        first_name: ENV.fetch("ASC_REVIEW_FIRST_NAME"),
        last_name: ENV.fetch("ASC_REVIEW_LAST_NAME"),
        email_address: ENV.fetch("ASC_REVIEW_EMAIL"),
        phone_number: ENV.fetch("ASC_REVIEW_PHONE"),
        demo_required: false,
        notes: File.read(File.expand_path("metadata/review_information/notes.txt", __dir__))
      }
    )
  end

  desc "Lataa kuvakaappaukset (fastlane/screenshots/fi)"
  lane :screenshots do
    asc_key
    deliver(
      app_version: app_version,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false
    )
  end

  desc "Rajaa jakelun pelkkään Suomeen (FIN), uusiin maihin ei automaattisesti"
  lane :availability do
    asc_key
    app = Spaceship::ConnectAPI::App.find("fi.inetor.metsainfo")
    client = Spaceship::ConnectAPI.client.tunes_request_client

    existing = begin
      client.get("v1/apps/#{app.id}/appAvailabilityV2").body["data"]
    rescue StandardError
      nil
    end

    if existing
      rows = client.get("v2/appAvailabilities/#{existing['id']}/territoryAvailabilities?limit=200&include=territory").body["data"]
      available = rows.select { |r| r.dig("attributes", "available") }
                      .map { |r| r.dig("relationships", "territory", "data", "id") }
      UI.message("Saatavuus on jo asetettu: #{available.join(', ')}")
      UI.important("Muuta alueita App Store Connectissa (Pricing and Availability), jos lista ei ole pelkkä FIN.") unless available == ["FIN"]
    else
      # Rajapinta vaatii kaikki alueet: FIN saatavilla, muut eivät
      territories = []
      path = "v1/territories?limit=200"
      while path
        page = client.get(path).body
        territories.concat(page["data"].map { |t| t["id"] })
        next_url = page.dig("links", "next")
        path = next_url && next_url.sub(%r{\Ahttps://[^/]+/}, "")
      end
      UI.user_error!("Aluetta FIN ei löytynyt") unless territories.include?("FIN")
      body = {
        data: {
          type: "appAvailabilities",
          attributes: { availableInNewTerritories: false },
          relationships: {
            app: { data: { type: "apps", id: app.id } },
            territoryAvailabilities: {
              data: territories.map { |t| { type: "territoryAvailabilities", id: "${#{t}}" } }
            }
          }
        },
        included: territories.map do |t|
          {
            type: "territoryAvailabilities",
            id: "${#{t}}",
            attributes: { available: t == "FIN" },
            relationships: { territory: { data: { type: "territories", id: t } } }
          }
        end
      }
      response = client.post("v2/appAvailabilities", body)
      UI.user_error!("Saatavuuden asetus epäonnistui: #{response.status} #{response.body}") if response.status >= 300
      UI.success("Jakelu rajattu Suomeen (FIN)")
    end

    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    loc = version.get_app_store_version_localizations.first
    info = app.fetch_edit_app_info.get_app_info_localizations.first
    UI.message("Tarkistus: kieli #{loc.locale}, nimi '#{info.name}', alaotsikko '#{info.subtitle}', avainsanat #{loc.keywords.to_s.length}/100, kuvaus #{loc.description.to_s.length} merkkiä")
  end

  desc "Ikäluokitus, sisältöoikeudet, hinta (ilmainen) ja uusin kelvollinen build versiolle"
  lane :release_settings do
    asc_key
    app = Spaceship::ConnectAPI::App.find("fi.inetor.metsainfo")
    client = Spaceship::ConnectAPI.client.tunes_request_client
    check = lambda do |response, what|
      # Relaatio-PATCH palauttaa 204 ilman runkoa (nil)
      if response && response.status >= 300
        UI.user_error!("#{what}: #{response.status} #{response.body}")
      end
      UI.success(what)
    end

    # Näyttää kolmannen osapuolen avointa dataa (Metsäkeskus, MML, Kapsi; CC BY 4.0)
    check.call(client.patch("v1/apps/#{app.id}", {
      data: { type: "apps", id: app.id, attributes: { contentRightsDeclaration: "USES_THIRD_PARTY_CONTENT" } }
    }), "Sisältöoikeudet: kolmannen osapuolen sisältö, oikeudet kunnossa")

    # Ikäluokitus: ei mitään luokiteltavaa sisältöä → 4+
    info = client.get("v1/apps/#{app.id}/appInfos").body["data"]
                 .find { |i| i.dig("attributes", "state") != "READY_FOR_DISTRIBUTION" }
    rating = client.get("v1/appInfos/#{info['id']}/ageRatingDeclaration").body["data"]
    none = %w[alcoholTobaccoOrDrugUseOrReferences contests gamblingSimulated gunsOrOtherWeapons
              medicalOrTreatmentInformation profanityOrCrudeHumor sexualContentGraphicAndNudity
              sexualContentOrNudity horrorOrFearThemes matureOrSuggestiveThemes violenceCartoonOrFantasy
              violenceRealisticProlongedGraphicOrSadistic violenceRealistic]
    no = %w[advertising gambling healthOrWellnessTopics lootBox messagingAndChat parentalControls
            ageAssurance socialMedia userGeneratedContent unrestrictedWebAccess]
    attributes = none.to_h { |k| [k, "NONE"] }.merge(no.to_h { |k| [k, false] })
    check.call(client.patch("v1/ageRatingDeclarations/#{rating['id']}", {
      data: { type: "ageRatingDeclarations", id: rating["id"], attributes: attributes }
    }), "Ikäluokitus")

    # Hinta: ilmainen, perusalue Suomi
    free = nil
    path = "v1/apps/#{app.id}/appPricePoints?filter[territory]=FIN&limit=200"
    while path && free.nil?
      page = client.get(path).body
      free = page["data"].find { |p| p.dig("attributes", "customerPrice").to_f.zero? }
      next_url = page.dig("links", "next")
      path = next_url && next_url.sub(%r{\Ahttps://[^/]+/}, "")
    end
    UI.user_error!("Ilmaista hintapistettä ei löytynyt") unless free
    check.call(client.post("v1/appPriceSchedules", {
      data: {
        type: "appPriceSchedules",
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          baseTerritory: { data: { type: "territories", id: "FIN" } },
          manualPrices: { data: [{ type: "appPrices", id: "${free}" }] }
        }
      },
      included: [{
        type: "appPrices", id: "${free}", attributes: { startDate: nil },
        relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } }
      }]
    }), "Hinta: ilmainen")

    # Build: uusin kelvollinen build muokattavalle versiolle
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version.version_string, sort: "-uploadedDate", limit: 10)
                                        .find { |b| b.processing_state == "VALID" }
    UI.user_error!("Versiolle #{version.version_string} ei ole kelvollista buildia") unless build
    check.call(client.patch("v1/appStoreVersions/#{version.id}/relationships/build", {
      data: { type: "builds", id: build.id }
    }), "Build #{build.version} liitetty versioon #{version.version_string}")
  end

  # App Storen versio public/version.js:n app-kentästä
  def app_version
    File.read(File.expand_path("../public/version.js", __dir__))[/app:\s*'([^']+)'/, 1]
  end
end
